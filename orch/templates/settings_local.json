{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Grep(*)",
      "LS(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "TodoRead(*)",
      "TodoWrite(*)",
      "mcp__*",
      "mcp__plugin_claude-mem_mcp-search__smart_outline",
      "mcp__plugin_claude-mem_mcp-search__smart_search"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,sys,json;\ntry:\n  d=json.load(sys.stdin)\nexcept Exception:\n  sys.exit(0)\nos.makedirs('.orch',exist_ok=True)\nopen('.orch/waiting_for_input','w').write(d.get('title','') + ': ' + d.get('message','Input needed'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [],
    "SessionStart": []
  }
}
